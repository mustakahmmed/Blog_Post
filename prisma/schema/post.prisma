model Post {
  id         String      @id @default(ulid())
  title      String      @db.VarChar(250)
  content    String      @db.Text
  thumbnail  String?
  isFeatured Boolean     @default(false)
  status     PostStatuss @default(PUBLIC)
  tag        String[]
  views      Int         @default(0)
  authorId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  comments   Comment[]

  @@index([authorId])
}

enum PostStatuss {
  DRAFT
  PUBLIC
  ARCHIVED
}
